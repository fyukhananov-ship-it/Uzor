# Базовый URL лендинга. На проде — https://uzor.app или выбранный домен.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# === Backend ===
# Лендинг — тонкий слой над FastAPI-сервисом (см. ../backend).
# Все сетевые вызовы из API routes (/api/session*) уходят сюда.
# В dev backend поднимается через `cd ../backend && uvicorn app.main:app`.
UZOR_BACKEND_URL=http://localhost:8000

# === Email (waitlist) ===
# [ОТКРЫТО] Email-провайдер для листа ожидания (PRD §13.1).
# UNISENDER_API_KEY=
