# Базовый URL лендинга. На проде — https://uzor.app или выбранный домен.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Claude API. Без ключа лендинг работает на детерминированных шаблонах
# (см. lib/observations.ts) — это нормальный режим разработки и для тестов.
# С ключом /api/session вызывает Anthropic Messages API.
# Получить: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Опционально: переопределить модель. Дефолт — claude-opus-4-7.
# Для cost-sensitive workloads можно поставить claude-sonnet-4-6 или claude-haiku-4-5.
# UZOR_LLM_MODEL=claude-opus-4-7

# [ОТКРЫТО] Backend API (когда появится). PRD §13.2: OpenRouter primary +
# YandexGPT резерв на стороне backend; сейчас лендинг ходит в Anthropic напрямую.
# UZOR_BACKEND_URL=http://localhost:8000

# [ОТКРЫТО] Email-провайдер для листа ожидания (PRD §13.1)
# UNISENDER_API_KEY=
