# Backend конфигурация. Скопируй в .env, заполни значения.

# === База данных ===
# Локально через docker-compose поднимается Postgres на 5432.
DATABASE_URL=postgresql+asyncpg://uzor:uzor@localhost:5432/uzor

# === Redis ===
# Используется для anonymous-session store (TTL 7 дней) и rate limiter.
REDIS_URL=redis://localhost:6379/0

# === JWT ===
# Любая длинная случайная строка для подписи токенов. Генерируй так:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-real-random-string-of-64-characters-or-more

# === LLM ===
# Без ключа backend падает на детерминированные шаблоны (как и web-лендинг).
# С ключом — реальный Claude.
ANTHROPIC_API_KEY=

# Опционально: переопределить модель. По умолчанию claude-opus-4-7.
# UZOR_LLM_MODEL=claude-opus-4-7

# === CORS ===
# Откуда лендинг и Android могут стучаться. Через запятую.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# === Среда ===
# development | production. Влияет на дебаг-флаги и доступ к /docs.
ENVIRONMENT=development
